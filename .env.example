# ———————————————————————————————
# NeuroDesk AI — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ———————————————————————————————

# ── Node API ────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── PostgreSQL ──────────────────────────────────────
# Set the password you chose when installing PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=neurodesk
POSTGRES_USER=neurodesk_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# ── Redis ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=REPLACE_IF_AUTH_ENABLED

# ── Neo4j ───────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD

# ── Python AI Service ───────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_INTERNAL_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ── Ollama (local LLM) ──────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3

# ── ChromaDB ────────────────────────────────────────
CHROMA_DATA_PATH=./data-local/chroma

# ── File storage ────────────────────────────────────
FILE_UPLOAD_PATH=./data-local/uploads
FILE_MAX_SIZE_MB=50

# ── Next.js Web Client ──────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_WS_URL=http://127.0.0.1:4000

# ── Cloud LLM (OPTIONAL — disabled by default) ──────
# Only set if the user explicitly enables cloud inference.
# GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
# HF_INFERENCE_API_KEY=REPLACE_WITH_HF_KEY

# ── External integrations (OPTIONAL — all disabled by default) ──
# SERPAPI_KEY=REPLACE_WITH_SERPAPI_KEY
# YOUTUBE_DATA_API_KEY=REPLACE_WITH_YOUTUBE_KEY
# RESEND_API_KEY=REPLACE_WITH_RESEND_KEY

