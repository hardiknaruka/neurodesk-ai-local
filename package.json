{
  "name": "neurodesk-ai",
  "version": "0.0.1",
  "private": true,
  "description": "AI Notebook + Chatbot + Memory + Multi-Agent + Knowledge Graph — local-first, no Docker",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./services/api\" dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
