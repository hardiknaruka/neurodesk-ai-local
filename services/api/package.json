{
  "name": "services-api",
  "version": "0.0.1",
  "private": true,
  "description": "NeuroDesk AI — Node.js + Express product API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.17.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.0",
    "socket.io": "^4.8.1",
    "pg": "^8.14.0",
    "axios": "^1.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.11.11",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "rimraf": "^6.0.0",
    "eslint": "^9.0.0"
  }
}

